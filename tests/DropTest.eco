/**
 * drop releases scoped instances and once caches.
 */

use container::{Builder, Container};

class DropCalls
{
    public int32 $n;

    public constructor()
    {
        $this->n = 0;
    }
}

class DropNote
{
    public int32 $n;

    public constructor(int32 $n)
    {
        $this->n = $n;
    }
}

test drop_child_releases_scope
{
    Builder $b = Builder();
    DropCalls $calls = DropCalls();
    $b->bind<DropNote>(scope: function() : DropNote {
        $calls->n = $calls->n + 1;
        return DropNote($calls->n);
    });
    Container $root = $b->seal();
    Container $req = $root->child();
    assert($req->get<DropNote>()->n == 1, 'first');
    $req->drop();
    assert($req->get<DropNote>()->n == 2, 'reconstructed');
    assert($calls->n == 2, 'ran twice');
}

test drop_root_releases_once
{
    Builder $b = Builder();
    DropCalls $calls = DropCalls();
    $b->bind<DropNote>(once: function() : DropNote {
        $calls->n = $calls->n + 1;
        return DropNote($calls->n);
    });
    Container $c = $b->seal();
    assert($c->get<DropNote>()->n == 1, 'first');
    $c->drop();
    assert($c->get<DropNote>()->n == 2, 'reconstructed');
    assert($calls->n == 2, 'ran twice');
}

test drop_root_keeps_put
{
    Builder $b = Builder();
    DropNote $note = DropNote(4);
    $b->bind<DropNote>(put: $note);
    Container $c = $b->seal();
    assert($c->get<DropNote>()->n == 4, 'first');
    $c->drop();
    assert($c->get<DropNote>()->n == 4, 'kept');
    $note->n = 9;
    assert($c->get<DropNote>()->n == 9, 'same object');
}

test drop_child_keeps_parent_once
{
    Builder $b = Builder();
    DropCalls $calls = DropCalls();
    $b->bind<DropNote>(once: function() : DropNote {
        $calls->n = $calls->n + 1;
        return DropNote($calls->n);
    });
    Container $root = $b->seal();
    Container $req = $root->child();
    assert($req->get<DropNote>()->n == 1, 'from parent');
    $req->drop();
    assert($root->get<DropNote>()->n == 1, 'parent kept');
    assert($calls->n == 1, 'once');
}
