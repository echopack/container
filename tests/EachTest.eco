/**
 * Per-get bindings.
 */

use container::{Builder, Container};

class EachNote
{
    public int32 $n;

    public constructor(int32 $n)
    {
        $this->n = $n;
    }
}

class EachCalls
{
    public int32 $n;

    public constructor()
    {
        $this->n = 0;
    }
}

test each_runs_the_factory_twice
{
    Builder $b = Builder();
    EachCalls $calls = EachCalls();
    $b->bind<EachNote>(each: function() : EachNote {
        $calls->n = $calls->n + 1;
        return EachNote($calls->n);
    });
    Container $c = $b->seal();

    EachNote $a = $c->get<EachNote>();
    EachNote $bNote = $c->get<EachNote>();
    assert($a->n == 1, 'first');
    assert($bNote->n == 2, 'second');
    assert($calls->n == 2, 'ran twice');
}

test each_instances_are_independent
{
    Builder $b = Builder();
    $b->bind<EachNote>(each: function() : EachNote {
        return EachNote(1);
    });
    Container $c = $b->seal();

    EachNote $a = $c->get<EachNote>();
    EachNote $bNote = $c->get<EachNote>();
    $a->n = 9;
    assert($bNote->n == 1, 'other copy');
}
