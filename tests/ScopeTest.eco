/**
 * scope caches per asking container.
 */

use container::{Builder, Container};

class ScopeNote
{
    public int32 $n;

    public constructor(int32 $n)
    {
        $this->n = $n;
    }
}

class ScopeCalls
{
    public int32 $n;

    public constructor()
    {
        $this->n = 0;
    }
}

class ScopeOnce
{
    public int32 $n;

    public constructor(int32 $n)
    {
        $this->n = $n;
    }
}

test scope_caches_on_the_ask
{
    Builder $b = Builder();
    ScopeCalls $calls = ScopeCalls();
    $b->bind<ScopeNote>(scope: function() : ScopeNote {
        $calls->n = $calls->n + 1;
        return ScopeNote($calls->n);
    });
    Container $c = $b->seal();

    ScopeNote $a = $c->get<ScopeNote>();
    ScopeNote $bNote = $c->get<ScopeNote>();
    assert($a->n == 1, 'first');
    assert($bNote->n == 1, 'cached on root');
    assert($calls->n == 1, 'ran once');
}

test scope_is_per_child
{
    Builder $b = Builder();
    ScopeCalls $calls = ScopeCalls();
    $b->bind<ScopeNote>(scope: function() : ScopeNote {
        $calls->n = $calls->n + 1;
        return ScopeNote($calls->n);
    });
    Container $root = $b->seal();

    Container $a = $root->child();
    Container $bChild = $root->child();
    assert($a->get<ScopeNote>()->n == 1, 'first child');
    assert($a->get<ScopeNote>()->n == 1, 'same child cached');
    assert($bChild->get<ScopeNote>()->n == 2, 'second child');
    assert($calls->n == 2, 'two constructions');
}

test once_is_shared_across_children
{
    Builder $b = Builder();
    ScopeCalls $calls = ScopeCalls();
    $b->bind<ScopeOnce>(once: function() : ScopeOnce {
        $calls->n = $calls->n + 1;
        return ScopeOnce($calls->n);
    });
    Container $root = $b->seal();
    Container $a = $root->child();
    Container $bChild = $root->child();
    assert($a->get<ScopeOnce>()->n == 1, 'first');
    assert($bChild->get<ScopeOnce>()->n == 1, 'shared');
    assert($calls->n == 1, 'once');
}

test scope_zero_arg_factory
{
    Builder $b = Builder();
    $b->bind<ScopeNote>(scope: function() : ScopeNote {
        return ScopeNote(3);
    });
    Container $c = $b->seal();
    assert($c->get<ScopeNote>()->n == 3, 'n');
}
